## 7. Database Schema

### 7.1 User Model

```js
{
  username:    { type: String, unique: true, required: true },
  email:       { type: String, unique: true, required: true },
  password:    { type: String, required: true },  // bcrypt hash
  avatarColor: { type: String, default: '#60a5fa' },
  createdAt:   { type: Date, default: Date.now }
}
```

### 7.2 Room Model

```js
{
  name:       { type: String, default: 'Untitled Lab' },
  code:       { type: String, unique: true },  // auto-generated 6-char code
  host:       { type: ObjectId, ref: 'User' },
  members:    [{ type: ObjectId, ref: 'User' }],
  isPublic:   { type: Boolean, default: true },
  maxMembers: { type: Number, default: 8 },
  status:     { type: String, enum: ['active', 'closed'], default: 'active' }
}
```

### 7.3 Experiment Model

```js
{
  title:       { type: String, required: true },
  description: String,
  creator:     { type: ObjectId, ref: 'User' },
  snapshot:    { type: Object },  // Version-1 serialized world JSON
  tags:        [String],
  isPublic:    { type: Boolean, default: true },
  views:       { type: Number, default: 0 }
}
```

